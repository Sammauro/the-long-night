{
  "statusLine": {
    "type": "command",
    "command": "node .claude/tools/usage_statusline.js"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/tools/budget_guard.js\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git checkout main*)",
      "Bash(git merge*main*)"
    ]
  }
}
